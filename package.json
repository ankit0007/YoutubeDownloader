{
  "name": "youtube-downloader-queue-app",
  "version": "1.0.6",
  "description": "Browser based YouTube downloader with queue support.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "clean:dist": "node scripts/cleanDist.js",
    "dist:msi": "npm run clean:dist && electron-builder --win msi nsis",
    "dist": "npm run clean:dist && electron-builder --win msi nsis"
  },
  "keywords": [
    "youtube",
    "downloader",
    "queue",
    "nodejs",
    "electron"
  ],
  "author": "YouTube Downloader Pro",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "sqlite3": "^6.0.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.youtubedownloader.pro",
    "productName": "YouTube Downloader Pro",
    "copyright": "Copyright © YouTube Downloader Pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "./scripts/afterPack.js",
    "files": [
      "electron/**/*",
      "lib/**/*",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/sqlite3/**",
      "**/node_modules/yt-dlp-exec/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "extraFiles": [
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Downloader Pro"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Downloader Pro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
